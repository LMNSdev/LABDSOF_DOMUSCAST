                </mxCell>
                <mxCell id="td4-16" edge="1" parent="1" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="ata = pendente_revisao; job = concluido">
                    <mxGeometry relative="1" as="geometry">
