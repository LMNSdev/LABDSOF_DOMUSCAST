                </mxCell>
                <mxCell id="td4-13" edge="1" parent="1" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="SELECT ... FOR UPDATE SKIP LOCKED">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="970" y="390" as="sourcePoint"/>
                        <mxPoint x="690" y="390" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="td4-14" edge="1" parent="1" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="envia áudio">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="970" y="430" as="sourcePoint"/>
                        <mxPoint x="1250" y="430" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="td4-15" edge="1" parent="1" style="html=1;rounded=0;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="transcrição + rascunho">
