<mxfile host="app.diagrams.net" pages="5">
  <diagram id="td1" name="1. Contexto do sistema">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="td1-2" value="Technical Design 8.1 - Contexto do sistema: quem usa a app e com que sistemas externos o backend fala" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="td1-3" value="Residente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="30" height="60" as="geometry"/></mxCell>
        <mxCell id="td1-4" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="30" height="60" as="geometry"/></mxCell>
        <mxCell id="td1-5" value="App móvel&lt;br&gt;(Flutter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="210" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="td1-6" value="API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="210" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="td1-7" value="PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="td1-8" value="Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="360" width="140" height="70" as="geometry"/></mxCell>
        <mxCell id="td1-9" value="Serviço de transcrição / IA" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="td1-10" value="Serviço de calendário&lt;br&gt;(simulador)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="470" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="td1-11" value="App de calendário&lt;br&gt;do residente (iCal)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="td1-20" value="Residentes e administrador usam a mesma app; o papel vem da identidade (US-15) ou da conta de administrador (US-01). O Worker fala com a IA e com o serviço de calendário; a API publica o feed iCal. Sem fornecedor de push: notificações geradas no telemóvel." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="td1-12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td1-3" target="td1-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="140"/><mxPoint x="190" y="231"/></Array></mxGeometry></mxCell>
        <mxCell id="td1-13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.7000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td1-4" target="td1-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="360"/><mxPoint x="190" y="259"/></Array></mxGeometry></mxCell>
        <mxCell id="td1-14" value="HTTPS / REST" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td1-5" target="td1-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td1-15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td1-6" target="td1-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td1-16" value="feed iCal" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td1-6" target="td1-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="155"/></Array></mxGeometry></mxCell>
