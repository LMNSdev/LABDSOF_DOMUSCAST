  <diagram id="td4" name="4. Workflow assincrono - transcricao da ata">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="td4-2" value="Technical Design 8.5 - Workflow assíncrono: transcrição e rascunho de ata (US-10)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="td4-3" value="App móvel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="140" height="790" as="geometry"/></mxCell>
        <mxCell id="td4-4" value="API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="140" height="790" as="geometry"/></mxCell>
        <mxCell id="td4-5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="140" height="790" as="geometry"/></mxCell>
        <mxCell id="td4-6" value="Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="140" height="790" as="geometry"/></mxCell>
        <mxCell id="td4-7" value="Serviço de IA" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="80" width="140" height="790" as="geometry"/></mxCell>
        <mxCell id="td4-8" value="loop  [a cada poll]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=70;height=24;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="700" height="380" as="geometry"/></mxCell>
        <mxCell id="td4-9" value="alt  [sucesso]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=70;height=24;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="660" height="215" as="geometry"/></mxCell>
        <mxCell id="td4-20" value="[falha ou timeout]" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="645" y="580" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="td4-21" value="Retries: backoff 1, 2, 4, 8, 16 min, máximo 5 tentativas; depois a ata fica falhou_transcricao e o administrador pode escrever a ata à mão (NFR-01). Duplicados: chave_idempotencia única por tipo de job; SKIP LOCKED evita dois Workers no mesmo job." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="885" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="td4-10" value="POST /reunioes/{id}/ata/audio" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="170" as="sourcePoint"/><mxPoint x="410" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-11" value="ata (a_transcrever) + job(transcrever, chave=ata_id)&lt;br&gt;na mesma transação" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="235" as="sourcePoint"/><mxPoint x="690" y="235" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-12" value="202 Accepted" style="html=1;rounded=0;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="290" as="sourcePoint"/><mxPoint x="130" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-13" value="SELECT ... FOR UPDATE SKIP LOCKED" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="390" as="sourcePoint"/><mxPoint x="690" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-14" value="envia áudio" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="430" as="sourcePoint"/><mxPoint x="1250" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-15" value="transcrição + rascunho" style="html=1;rounded=0;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="505" as="sourcePoint"/><mxPoint x="970" y="505" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-16" value="ata = pendente_revisao; job = concluido" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="550" as="sourcePoint"/><mxPoint x="690" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-17" value="tentativas + 1; proxima_tentativa_em = backoff exponencial" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="640" as="sourcePoint"/><mxPoint x="690" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-18" value="GET /reunioes/{id}/ata (polling)" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="770" as="sourcePoint"/><mxPoint x="410" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-19" value="estado atual da ata" style="html=1;rounded=0;endArrow=open;endFill=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="820" as="sourcePoint"/><mxPoint x="130" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="td4-22" value="" style="html=1;dashed=1;endArrow=none;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="600" as="sourcePoint"/><mxPoint x="1300" y="600" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="td5" name="5. Vista de deployment">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="td5-2" value="Technical Design 8.8 - Vista de deployment: pipeline, contentores e app" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="td5-3" value="GitHub Actions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="150" as="geometry"/></mxCell>
        <mxCell id="td5-4" value="lint + testes&lt;br&gt;ruff, pytest,&lt;br&gt;flutter analyze/test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="td5-5" value="build de imagens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="td5-6" value="push GHCR&lt;br&gt;(tag do commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="td5-7" value="deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="td5-8" value="APK Android&lt;br&gt;(distribuído aos docentes)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1160" y="115" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="td5-9" value="Docker Compose - ambiente de avaliação (TODO: VM ou máquina da equipa)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1060" height="430" as="geometry"/></mxCell>
        <mxCell id="td5-10" value="simulador-&lt;br&gt;calendario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-11" value="api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-12" value="media&lt;br&gt;(volume)" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;tabWidth=60;tabHeight=14;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-13" value="worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-14" value="postgres" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="td5-15" value="prometheus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-16" value="grafana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="td5-29" value="api e worker partilham a mesma imagem (comando diferente). Prometheus recolhe /metrics de api e worker. Configuração por variáveis de ambiente; segredos (chave de IA) só em .env não versionado ou GitHub secrets. Rollback: docker compose up com a tag anterior; migrações Alembic só aditivas no MVP." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="td5-17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td5-4" target="td5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
