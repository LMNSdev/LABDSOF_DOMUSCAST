  </diagram>
  <diagram id="td2" name="2. Vista de contentores">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="td2-2" value="Technical Design 8.2 - Vista de contentores: App, API, Worker, PostgreSQL e volume de ficheiros" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="td2-3" value="Dispositivo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="td2-4" value="App móvel (Flutter)&lt;br&gt;&lt;br&gt;jornadas dos Workflows 1 a 6&lt;br&gt;credencial do dispositivo&lt;br&gt;fila local SQLite&lt;br&gt;sincronização em segundo plano&lt;br&gt;notificações locais" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="td2-5" value="Backend (Docker Compose)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="640" height="540" as="geometry"/></mxCell>
        <mxCell id="td2-6" value="API (FastAPI)&lt;br&gt;&lt;br&gt;REST, autenticação, autorização,&lt;br&gt;validação, regras de negócio,&lt;br&gt;escreve jobs no outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="120" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="td2-7" value="Volume media&lt;br&gt;fotos e áudios" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;tabWidth=60;tabHeight=14;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="td2-8" value="Worker (Python)&lt;br&gt;&lt;br&gt;consome a tabela job:&lt;br&gt;transcrição, publicação&lt;br&gt;no serviço de calendário" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="450" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="td2-9" value="PostgreSQL&lt;br&gt;dados + tabela job" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="125" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="td2-10" value="Serviço de IA" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="td2-11" value="Simulador de calendário&lt;br&gt;(contentor)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="td2-19" value="API e Worker partilham o mesmo código Python e a mesma imagem Docker; arrancam como contentores separados (ADR-004). PostgreSQL é a única base de dados e serve de fila de jobs (ADR-005)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="td2-12" value="REST/JSON (síncrono)" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-4" target="td2-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td2-13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-6" target="td2-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td2-14" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-6" target="td2-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td2-15" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-8" target="td2-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="td2-16" value="tabela job" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.8818;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-8" target="td2-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="480"/><mxPoint x="720" y="222"/></Array></mxGeometry></mxCell>
        <mxCell id="td2-17" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.5833;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-8" target="td2-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="520"/><mxPoint x="1050" y="540"/></Array></mxGeometry></mxCell>
        <mxCell id="td2-18" value="" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1.0000;exitY=0.8750;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="td2-8" target="td2-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="555"/><mxPoint x="1060" y="640"/></Array></mxGeometry></mxCell>
