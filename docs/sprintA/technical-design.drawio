                    <mxGeometry height="790" width="140" x="1180" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="td4-8" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=70;height=24;" value="loop  [a cada poll]" vertex="1">
                    <mxGeometry height="380" width="700" x="620" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="td4-9" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=70;height=24;" value="alt  [sucesso]" vertex="1">
                    <mxGeometry height="215" width="660" x="640" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="td4-20" parent="1" style="text;html=1;fontSize=11;align=left;" value="[falha ou timeout]" vertex="1">
                    <mxGeometry height="20" width="200" x="645" y="580" as="geometry"/>
                </mxCell>
                <mxCell id="td4-21" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="Retries: backoff 1, 2, 4, 8, 16 min, máximo 5 tentativas; depois a ata fica falhou_transcricao e o administrador pode escrever a ata à mão (NFR-01). Duplicados: chave_idempotencia única por tipo de job; SKIP LOCKED evita dois Workers no mesmo job." vertex="1">
                    <mxGeometry height="40" width="1300" x="60" y="885" as="geometry"/>
                </mxCell>
                <mxCell id="td4-10" edge="1" parent="1" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="POST /reunioes/{id}/ata/audio">
