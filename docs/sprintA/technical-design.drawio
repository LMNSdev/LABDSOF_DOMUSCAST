          <mxGeometry x="340" y="80" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="td4-5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="td4-6" value="Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="td4-7" value="Serviço de IA" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="80" width="140" height="760" as="geometry" />
        </mxCell>
        <mxCell id="td4-8" value="POST /reunioes/{id}/ata/audio" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150.0" y="160" as="sourcePoint" />
            <mxPoint x="410.0" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-9" value="ata (a_transcrever) + job(transcrever, chave=ata_id)&lt;br&gt;na mesma transação" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410.0" y="210" as="sourcePoint" />
            <mxPoint x="670.0" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-10" value="202 Accepted" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410.0" y="260" as="sourcePoint" />
            <mxPoint x="150.0" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-11" value="loop  [a cada poll]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=60;height=24;verticalAlign=top;align=left;spacingLeft=70;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="520" height="330" as="geometry" />
        </mxCell>
        <mxCell id="td4-12" value="SELECT ... FOR UPDATE SKIP LOCKED" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930.0" y="350" as="sourcePoint" />
            <mxPoint x="670.0" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-13" value="envia áudio" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930.0" y="400" as="sourcePoint" />
            <mxPoint x="1190.0" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-14" value="alt  [sucesso]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;width=60;height=24;verticalAlign=top;align=left;spacingLeft=70;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="480" height="190" as="geometry" />
        </mxCell>
        <mxCell id="td4-15" value="transcrição + rascunho" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1190.0" y="470" as="sourcePoint" />
            <mxPoint x="930.0" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-16" value="ata = pendente_revisao; job = concluido" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930.0" y="510" as="sourcePoint" />
            <mxPoint x="670.0" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-17" value="[falha ou timeout]" style="html=1;dashed=1;endArrow=none;rounded=0;align=left;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="545" as="sourcePoint" />
            <mxPoint x="1320" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-18" value="tentativas + 1; proxima_tentativa_em = backoff exponencial" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930.0" y="585" as="sourcePoint" />
            <mxPoint x="670.0" y="585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-19" value="GET /reunioes/{id}/ata (polling)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150.0" y="680" as="sourcePoint" />
            <mxPoint x="410.0" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-20" value="estado atual da ata" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410.0" y="730" as="sourcePoint" />
            <mxPoint x="150.0" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="td4-21" value="Retries: backoff 1, 2, 4, 8, 16 min, máximo 5 tentativas; depois a ata fica falhou_transcricao e o administrador pode escrever a ata à mão (NFR-01). Duplicados: chave_idempotencia única por tipo de job; SKIP LOCKED evita dois Workers no mesmo job." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="850" width="1200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
