                        <mxPoint x="690" y="550" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="td4-17" edge="1" parent="1" style="html=1;rounded=0;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;verticalAlign=bottom;" value="tentativas + 1; proxima_tentativa_em = backoff exponencial">
