                    <mxGeometry height="30" width="1100" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="td4-3" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="App móvel" vertex="1">
                    <mxGeometry height="790" width="140" x="60" y="80" as="geometry"/>
                </mxCell>
