                <mxCell id="td5-8" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" value="APK Android&lt;br&gt;(distribuído aos docentes)" vertex="1">
                    <mxGeometry height="80" width="200" x="1160" y="115" as="geometry"/>
                </mxCell>
                <mxCell id="td5-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" value="Docker Compose - ambiente de avaliação (TODO: VM ou máquina da equipa)" vertex="1">
