  <diagram id="td3" name="3. Modelo de dados">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="td3-2" value="Technical Design 8.3 - Modelo de dados (entidades e relações principais)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="td3-3" value="&lt;b&gt;condominio&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, nome, n_fracoes, criado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="td3-4" value="&lt;b&gt;administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, condominio_id, nome&lt;br&gt;credencial_hash&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="900" y="30" width="240" height="78" as="geometry"/></mxCell>
        <mxCell id="td3-5" value="&lt;b&gt;fracao&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, condominio_id, designacao&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="320" height="58" as="geometry"/></mxCell>
        <mxCell id="td3-6" value="&lt;b&gt;aviso&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, condominio_id, reporte_id?&lt;br&gt;titulo, texto, local&lt;br&gt;publicado_em, arquivado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="260" height="98" as="geometry"/></mxCell>
        <mxCell id="td3-7" value="&lt;b&gt;reuniao&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, condominio_id, data_hora, local&lt;br&gt;calendario_externo_id, estado_sync&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1280" y="180" width="260" height="78" as="geometry"/></mxCell>
        <mxCell id="td3-8" value="&lt;b&gt;qr_token&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, fracao_id, token_hash&lt;br&gt;criado_em, revogado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="240" height="78" as="geometry"/></mxCell>
        <mxCell id="td3-9" value="&lt;b&gt;identidade&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, fracao_id, nome, nome_normalizado, papel&lt;br&gt;credencial_hash, criado_em, removida_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="td3-10" value="&lt;b&gt;reporte&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, condominio_id, autor_id, descricao&lt;br&gt;foto_path, foto_alt, mostrar_nome&lt;br&gt;estado, duplicado_de_id&lt;br&gt;criado_em, atualizado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="260" height="118" as="geometry"/></mxCell>
        <mxCell id="td3-11" value="&lt;b&gt;reporte_historico&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, reporte_id, estado_anterior&lt;br&gt;estado_novo, nota, autor_tipo&lt;br&gt;autor_id, criado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="260" height="98" as="geometry"/></mxCell>
        <mxCell id="td3-12" value="&lt;b&gt;reporte_seguidor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;reporte_id, identidade_id&lt;br&gt;tipo (autor, co_reporter, seguidor)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="260" height="78" as="geometry"/></mxCell>
        <mxCell id="td3-13" value="&lt;b&gt;ata&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, reuniao_id, audio_path&lt;br&gt;transcricao, rascunho, texto_aprovado&lt;br&gt;estado, aprovada_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1280" y="310" width="260" height="98" as="geometry"/></mxCell>
        <mxCell id="td3-14" value="&lt;b&gt;job&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;id, tipo, chave_idempotencia&lt;br&gt;payload, estado, tentativas&lt;br&gt;proxima_tentativa_em, erro, criado_em&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1280" y="470" width="260" height="98" as="geometry"/></mxCell>
        <mxCell id="td3-29" value="Notação pé-de-galinha (um, zero ou um, muitos). reporte.duplicado_de_id aponta para outro reporte (US-04). reporte_historico é só inserção (US-05). job é o outbox consumido pelo Worker (8.5). identidade.papel: residente ou comissao (US-12). nome_normalizado é único por fração (US-15)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1000" height="60" as="geometry"/></mxCell>
