        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Valida o pedido (campos obrigatorios, anexos, autenticacao)" vertex="1">
          <mxGeometry height="70" width="160" x="520" y="175" as="geometry" />
        </mxCell>
