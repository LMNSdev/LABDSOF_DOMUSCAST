          <mxGeometry height="60" width="150" x="150" y="40" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Preenche descricao e, opcionalmente, foto com texto alternativo (acessivel por leitor de ecra)" vertex="1">
          <mxGeometry height="70" width="160" x="330" y="35" as="geometry" />
        </mxCell>
