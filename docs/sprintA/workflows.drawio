        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" value="Guarda o pedido: estado &quot;Aberto - pendente de triagem&quot;, reporter = autor; visivel so ao reporter e ao administrador" vertex="1">
          <mxGeometry height="70" width="190" x="900" y="175" as="geometry" />
