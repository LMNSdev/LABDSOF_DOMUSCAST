  <diagram id="wf2" name="2. Reportar e acompanhar avaria">
    <mxGraphModel dx="1107" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="700" math="0" shadow="0">
