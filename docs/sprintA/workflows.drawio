        <mxCell id="t" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;" value="Workflow 3 - Administrador: acompanhar e resolver pedidos com historico auditavel e aviso ligado ao pedido (US-04, US-05, US-14)" vertex="1">
          <mxGeometry height="30" width="1100" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;swimlaneFillColor=#ffffff;" value="Administrador" vertex="1">
          <mxGeometry height="140" width="1990" as="geometry" />
        </mxCell>
        <mxCell id="dr" parent="l1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="O pedido representa um risco para os residentes?" vertex="1">
          <mxGeometry height="90" width="170" x="490" y="40" as="geometry" />
