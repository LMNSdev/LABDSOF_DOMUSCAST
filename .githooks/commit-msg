#!/bin/sh
# Valida a mensagem de commit: "<issue_id> - <descrição>"
# Formatos aceites: "[#12] - texto", "#12 - texto", "12 - texto" ou várias issues, ex.: "[#12, #13] - texto".

msg_file="$1"

# Primeira linha que não seja vazia nem comentário do Git ("# texto")
subject=$(grep -Ev '^#([[:space:]]|$)' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1)

# Merges, reverts e fixups automáticos do Git não são validados
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

id='#?[0-9]+'
ids="$id(, ?$id)*"

if printf '%s\n' "$subject" | grep -Eq "^(\[$ids\]|$ids) - [^[:space:]].*"; then
  exit 0
fi

cat >&2 <<EOF
Commit rejeitado: a mensagem tem de seguir "<issue_id> - <descrição>".

  Exemplo: [#12] - Adiciona formulário de reporte de fuga de água
  Várias issues: [#12, #13] - Adiciona formulário e validação

Mensagem recebida: "$subject"
EOF
exit 1
